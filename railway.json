{
  "build": {
    "builder": "nixpacks",
    "buildCommand": "npm install && cd apps/api && npx prisma generate && npx tsc -p tsconfig.json",
    "config": {
      "node": { "version": "22" }
    }
  },
  "deploy": {
    "startCommand": "node apps/api/dist/apps/api/src/main.js",
    "healthcheckPath": "/health",
    "restartPolicyType": "ON_FAILURE"
  }
}
