{
  "name": "@night-nest/api",
  "private": true,
  "version": "0.3.2",
  "description": "NestJS API for Night Nest",
  "scripts": {
    "dev": "tsc -p tsconfig.json && node dist/apps/api/src/main.js",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/apps/api/src/main.js",
    "prisma:generate": "prisma generate",
    "prisma:seed": "tsx prisma/seed/seed-runner.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@prisma/client": "^6.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "prisma": "^6.0.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
}
